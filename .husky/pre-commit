#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

NODE_BIN="${NODE_BIN:-node}"
if ! command -v "$NODE_BIN" >/dev/null 2>&1; then
  for candidate in \
    "/mnt/c/nvm4w/nodejs/node.exe" \
    "/mnt/c/Program Files/nodejs/node.exe"; do
    if [ -f "$candidate" ]; then
      NODE_BIN="$candidate"
      break
    fi
  done
fi

if ! command -v "$NODE_BIN" >/dev/null 2>&1; then
  if [ ! -f "$NODE_BIN" ]; then
    echo "[husky] Unable to locate node executable" >&2
    exit 1
  fi
fi

"$NODE_BIN" ./node_modules/lint-staged/bin/lint-staged.js
