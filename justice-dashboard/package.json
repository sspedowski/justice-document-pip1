{
  "name": "justice-dashboard",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "npm-run-all --parallel dev:client dev:server",
    "dev:client": "vite --host --port 5174",
    "dev:server": "nodemon ../justice-server/server.js",
  "build:css": "postcss src/index.css -o dist/output.css",
  "watch:css": "postcss src/index.css -o dist/output.css --watch",
  "build": "vite build",
    "build:prod": "set NODE_ENV=production && npm run build",
    "start": "node ../justice-server/server.js",
    "start:prod": "NODE_ENV=production node ../justice-server/server.js",
    "deploy:firebase": "npm run build:prod && firebase deploy",
    "deploy:vercel": "npm run build:prod && vercel --prod",
    "check": "node check-files.js",
    "deploy:check": "cross-env NODE_ENV=production node deployment-check.js",
    "deploy:check:win": "set NODE_ENV=production && node deployment-check.js",
    "security:check": "npm audit && npm run lint",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:report": "eslint . -f stylish -o tmp-eslint-output.txt",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
  "test": "cross-env NODE_ENV=test vitest",
  "test:run": "cross-env NODE_ENV=test vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "test:e2e": "cypress run",
    "cleanup": "pwsh -NoProfile -File ../cleanup-and-structure.ps1",
    "cleanup:windows": "powershell -ExecutionPolicy Bypass -File cleanup-and-structure.ps1",
    "test-pdf": "python test_pdf_processing.py",
    "update-pdf": "python update_pdf_links.py",
    "update-pdf-links": "node scripts/update-pdf-links.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "browserslist": [
    "last 2 versions",
    "not dead",
    "not ie <= 11",
    "not op_mini all",
    "Chrome >= 54",
    "Firefox >= 60",
    "Safari >= 12",
    "Edge >= 79"
  ],
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.0",
    "@eslint/js": "^9.14.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.0",
    "lint-staged": "^16.1.2",
    "lucide-react": "^0.542.0",
    "nodemon": "^3.1.10",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.24",
    "postcss-cli": "^10.1.0",
    "prettier": "^3.6.2",
    "supertest": "^6.3.3",
    "tailwindcss": "^3.3.2",
    "ts-morph": "^23.0.0",
    "vite": "5.4.19",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
