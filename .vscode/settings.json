// VS Code workspace settings (JSON with comments allowed)
{
  // ESLint
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": [{ "mode": "auto" }],

  // Disable Jest noise (we use Vitest here)
  "jest.enable": false,
  "jest.runMode": "on-demand",

  // Error Lens – helpful but not noisy
  "errorLens.enabled": true,
  "errorLens.delay": 120,
  "errorLens.messageBackgroundMode": "line",
  "errorLens.enabledDiagnosticLevels": ["error"],
  "errorLens.margin": "90",

  // Tailwind IntelliSense (enable Emmet mapping)
  "tailwindCSS.emmetCompletions": true,
  // Tailwind config for the Vite app
  "tailwindCSS.experimental.configFile": "justice-dashboard/tailwind.config.js",

  // YAML schemas (GitHub Actions)
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": ".github/workflows/*.{yml,yaml}"
  },

  // GitLens – line blame and codelens
  "gitlens.codeLens.enabled": true,
  "gitlens.currentLine.enabled": true,

  // Spell checker words
  "cSpell.words": [
    "AppCheck",
    "adminpass",
    "Allegan",
    "Aversys",
    "Barry",
    "Baskin",
    "BRAINS",
    "Cantarell",
    "CTAC",
    "Eleanora",
    "Firestore",
    "Gladding",
    "Huizenga",
    "Jace",
    "Josh",
    "Muldrow",
    "Nextjs",
    "Peyton",
    "pwsh",
    "Pylance",
    "Rtdb",
    "RTDB",
    "getRtdb",
    "Spedowski",
    "subapp",
    "Vercel",
    "Vite"
  ]
}
