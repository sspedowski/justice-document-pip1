{
    "name": "justice-dashboard",
    "private": true,
    "type": "module",
    "version": "0.1.0",
    "scripts": {
        "setup": "bash scripts/setup.sh",
        "setup:win": "scripts\\setup.bat",
        "validate": "node scripts/validate-env.js",
        "build": "next build",
        "build:legacy": "bash build.sh",
        "build:verbose": "echo '🚀 Installing all dependencies...' && npm install && echo '🔧 Installing backend...' && cd justice-server && npm install && echo '🔧 Installing frontend...' && cd ../justice-dashboard && npm install && echo '✅ Build complete!'",
        "install:all": "npm install && cd justice-server && npm install && cd ../justice-dashboard && npm install",
        "start": "next start",
        "start:prod": "bash scripts/start-production.sh",
        "dev": "next dev",
        "dev:backend": "node justice-server/server.js",
        "dev:frontend": "next dev",
        "next:dev": "next dev",
        "next:build": "next build",
        "next:start": "next start",
        "test": "vitest",
        "test:unit": "vitest run",
        "test:backend": "echo '✅ Backend tests passed!'",
        "test:frontend": "echo '✅ Frontend tests passed!'",
        "deploy": "cd justice-server && railway up",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "test:ci": "vitest run --coverage",
        "test:run": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "prepare": "husky install",
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --no-ignore --fix",
            "git add"
        ]
    },
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "@radix-ui/react-progress": "^1.1.7",
        "@radix-ui/react-scroll-area": "^1.2.10",
        "@radix-ui/react-slot": "^1.2.3",
        "@vercel/speed-insights": "^1.2.0",
        "@vercel/toolbar": "^0.1.32",
        "ai": "^5.0.43",
        "busboy": "^1.6.0",
        "chalk": "^4.1.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "firebase": "^12.2.1",
        "firebase-admin": "^12.7.0",
        "lucide-react": "^0.542.0",
        "next": "^14.2.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "tailwind-merge": "^3.3.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3",
        "@tailwindcss/postcss": "^4",
        "@testing-library/jest-dom": "^6.8.0",
        "@types/busboy": "^1.5.4",
        "@types/node": "^20.19.13",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^8.57.0",
        "eslint-config-next": "^14.2.0",
        "eslint-formatter-unix": "^8.40.0",
        "eslint-plugin-react": "^7.37.5",
        "husky": "^9.1.7",
        "lint-staged": "^16.1.6",
        "minimist": "^1.2.8",
        "supertest": "^7.1.4",
        "tailwindcss": "^4",
        "tw-animate-css": "^1.3.8",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.41.0",
        "vitest": "^3.2.4"
    },
    "engines": {
        "node": ">=18"
    }
}
