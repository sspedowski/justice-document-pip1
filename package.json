{
  "name": "justice-dashboard",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "setup:win": "scripts\\setup.bat",
    "validate": "node scripts/validate-env.js",
    "build": "next build",
    "start": "next start",
    "dev": "next dev",
    "dev:backend": "node justice-server/server.js",
    "dev:frontend": "next dev",
    "start:prod": "bash scripts/start-production.sh",
    "deploy": "cd justice-server && railway up",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest --config jest.config.cjs --runInBand",
    "test:unit": "vitest run",
    "test:ci": "vitest run --reporter=dot",
    "test:run": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "git reset --hard && git clean -xfd && node -e \"require('fs').rmSync('.next',{recursive:true,force:true}); require('fs').rmSync('node_modules',{recursive:true,force:true});\""
  },
  "prepare": "husky install",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --no-ignore --fix",
      "git add"
    ]
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.3",
    "@upstash/ratelimit": "^1.0.0",
    "@upstash/redis": "^1.31.6",
    "@vercel/blob": "^0.25.0",
    "@vercel/kv": "^1.0.0",
    "@vercel/speed-insights": "^1.2.0",
    "@vercel/toolbar": "^0.1.32",
    "busboy": "^1.6.0",
    "chalk": "^4.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "file-type": "^18.7.0",
    "firebase": "^12.2.1",
    "firebase-admin": "^12.7.0",
    "lucide-react": "^0.542.0",
    "mime": "^3.0.0",
    "next": "^14.2.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.3.1"
    ,
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/eslint-parser": "^7.28.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "@eslint/eslintrc": "^3",
    "@testing-library/jest-dom": "^6.8.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.13",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^9.0.7",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^30.1.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "eslint-formatter-unix": "^8.40.0",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.1.6",
    "minimist": "^1.2.8",
    "supertest": "^7.1.4",
    "tailwindcss": "^4",
    "ts-jest": "^29.1.2",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^1.6.1"
  },
  "engines": { "node": ">=20" }
}
