{
  "name": "justice-dashboard",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": "20.11.1",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint -c config/.eslintrc.json .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec",
    "test:unit-node": "node --test --test-reporter=spec --loader ./tools/alias-loader.mjs \"tests-node/**/*.mjs\"",
    "linkcheck": "lychee --no-progress --verbose --include-fragments --accept 200,206 --max-redirects 5 ."
  },
  "prepare": "husky install",
  "lint-staged": {
    "app/**/*.{ts,tsx,js,jsx}": "eslint --fix",
    "lib/**/*.{ts,tsx,js,jsx}": "eslint --fix",
    "next.config.*": "eslint --fix",
    "middleware.ts": "eslint --fix",
    "packages/justice-dashboard/src/**/*.{js,jsx,ts,tsx}": "pnpm --filter justice-dashboard test -- --changed"
  },
  "dependencies": {
    "zod": "^3.23.8",
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.3",
    "@vercel/speed-insights": "^1.2.0",
    "@vercel/toolbar": "^0.1.32",
    "ai": "^5.0.43",
    "busboy": "^1.6.0",
    "chalk": "^4.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.2",
    "firebase": "^12.2.1",
    "firebase-admin": "^12.7.0",
    "lucide-react": "^0.542.0",
    "next": "^14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.3.1",
    "styled-jsx": "^5.1.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@types/busboy": "^1.5.4",
    "@types/node": "^20.19.13",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^8.12.2",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "eslint-config-next": "^14.2.0",
    "eslint-formatter-unix": "^8.40.0",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "minimist": "^1.2.8",
    "supertest": "^7.1.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
