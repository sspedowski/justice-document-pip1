{
  "name": "justice-dashboard",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "publish:dashboard": "npm run publish:dashboard:posix",
    "publish:dashboard:win": "powershell -ExecutionPolicy Bypass -File ./scripts/publish-dashboard.ps1 -VitePath ./dashboard -AltPath ./justice-dashboard -NextPublic ./public/dashboard",
    "build:dashboard": "npm --prefix justice-dashboard run build",
    "build+publish:dashboard:win": "npm run build:dashboard && npm run publish:dashboard:win",
    "build+publish:dashboard": "npm run build:dashboard && npm run publish:dashboard",
    "vite:lint": "npm --prefix justice-dashboard run lint",
    "vite:build:ci": "npm --prefix justice-dashboard run build:ci",
    "vite:dev": "npm --prefix justice-dashboard run dev",
    "vite:preview": "npm --prefix justice-dashboard run preview",
    "publish:dashboard:posix": "bash scripts/publish-dashboard.sh ./dashboard ./justice-dashboard ./public/dashboard",
    "typecheck": "tsc --noEmit",
    "dash:publish:posix": "npm run publish:dashboard:posix",
    "dash:publish:win": "npm run publish:dashboard:win",
    "next-config:prepare": "node scripts/prepare-next-config.mjs",
    "predev": "node scripts/prepare-next-config.mjs",
    "prebuild": "node scripts/prepare-next-config.mjs && node scripts/publish-dashboard.mjs ./dashboard ./justice-dashboard ./public/dashboard",
    "prestart": "node scripts/prepare-next-config.mjs && node scripts/publish-dashboard.mjs ./dashboard ./justice-dashboard ./public/dashboard",
    "prelint": "node scripts/prepare-next-config.mjs",
    "e2e": "playwright test",
    "test:unit": "vitest run",
    "ci:full": "npm run build && npm run test:unit && npm run e2e",
    "smoke:dev:ps": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-smoke.ps1 -Port 3020 -TimeoutSec 120",
    "smoke:dev:sh": "bash ./scripts/dev-smoke.sh"
  },
  "prepare": "husky install",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0 --fix",
      "node scripts/run-vitest-changed.mjs"
    ],
    "{app,lib}/**/*.{ts,tsx,js,jsx}": [
      "eslint --max-warnings=0 --fix"
    ],
    "next.config.*": "eslint --max-warnings=0 --fix",
    "middleware.ts": "eslint --max-warnings=0 --fix",
    "*.{css,scss,md,yml,yaml,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.3",
    "@vercel/speed-insights": "^1.2.0",
    "@vercel/toolbar": "^0.1.32",
    "ai": "^5.0.43",
    "busboy": "^1.6.0",
    "chalk": "^4.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.2",
    "firebase": "^12.2.1",
    "firebase-admin": "^12.7.0",
    "lucide-react": "^0.542.0",
    "next": "^14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@types/busboy": "^1.5.4",
    "@types/node": "^20.19.13",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "eslint-formatter-unix": "^8.40.0",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "minimist": "^1.2.8",
    "prettier": "^3.6.0",
    "supertest": "^7.1.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.17.0 <21"
  }
}
