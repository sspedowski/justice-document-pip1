{
  "root": true,
  "extends": ["next/core-web-vitals"],
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "legacy/",
    "frontend/",
    "web/",
    "backend/",
    "justice-dashboard/",
    "justice-server/",
    "dist/",
    "build/"
  ],
  "settings": {
    "react": { "version": "detect" }
  },
  "overrides": [
    {
      "files": ["*.ts", "*.tsx"],
      "parserOptions": { "project": false }
    },
    {
      "files": [
        "next.config.*",
        "postcss.config.*",
        "tailwind.config.*",
        "scripts/**/*",
        "justice-server/**/*.js",
        "backend/**/*.js"
      ],
      "env": { "node": true }
    }
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/jsx-uses-react": "off"
  }
}
