{
  "root": true,
  "extends": ["next/core-web-vitals", "next/typescript"],
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "legacy/",
    "frontend/",
    "web/",
    "backend/",
    "justice-dashboard/",
    "justice-server/",
    "dist/",
    "build/"
  ],
  "overrides": [
    {
      "files": ["*.ts", "*.tsx"],
      "parserOptions": { 
        "project": false,
        "ecmaVersion": "latest",
        "sourceType": "module"
      }
    },
    {
      "files": [
        "next.config.*",
        "postcss.config.*",
        "tailwind.config.*",
        "scripts/**/*",
        "justice-server/**/*.js",
        "backend/**/*.js"
      ],
      "env": { "node": true }
    }
  ],
  "rules": {
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-require-imports": "warn"
  }
}
