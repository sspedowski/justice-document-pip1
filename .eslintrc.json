{
  "root": true,
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["error", {
      "args": "after-used",
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^(_|ignore|unused)$",
      "caughtErrors": "none"
    }],
    "no-console": ["warn", { "allow": ["info", "warn", "error", "debug"] }]
  }
}